<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Glint.App"
             xmlns:local="using:Glint"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- System Tray Icon -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico"
                      ToolTipText="Glint — Screenshot Tool"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Glint" Click="ShowWindow_Click" />
                        <NativeMenuItem Header="Capture Screen" Click="CaptureScreen_Click" />
                        <NativeMenuItem Header="Capture Region" Click="CaptureRegion_Click" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit Glint" Click="QuitApp_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>